---
import BaseLayout from '../layouts/BaseLayout.astro';
import GraphObservatory from '../components/GraphObservatory.astro';
import EntryCard from '../components/EntryCard.astro';
import {getCollection,getEntry,render} from 'astro:content';
import {localUrl} from '../lib/urls';
const home=await getEntry('pages','home');
if(!home) throw new Error('Missing content/home.md');
const {Content}=await render(home);
const entries=await getCollection('pages');
const research=entries.filter(p=>p.id.startsWith('research/') && p.id.split('/').length===2).sort((a,b)=>(a.data.order||99)-(b.data.order||99));
const projects=entries.filter(p=>p.id.startsWith('projects/') && p.id.split('/').length===2 && p.data.featured).sort((a,b)=>(a.data.order||99)-(b.data.order||99));
---
<BaseLayout title={home.data.title+' — Research'} description={home.data.description}>
 <section class="hero container">
  <div class="hero-copy">
   <div class="eyebrow"><span class="eyebrow-stripe"></span>{home.data.eyebrow || 'RESEARCH / OPEN SCIENCE'}</div>
   <h1>{home.data.title}</h1>
   <p class="hero-subtitle">{home.data.subtitle}</p>
   <p class="hero-lead">{home.data.description}</p>
   <div class="hero-actions"><a class="primary-button" href={localUrl('/research/')}>EXPLORE RESEARCH <span>↗</span></a><a class="text-link" href={localUrl('/about/')}>ABOUT ME →</a></div>
   <div class="hero-bottom"><span><i class="live-indicator"></i> OPEN / FREE / COLLABORATIVE</span><span>SCROLL TO EXPLORE ↓</span></div>
  </div>
  <GraphObservatory/>
 </section>
 <section class="container home-editorial"><div class="section-kicker">00 / FROM THE LAB</div><article class="prose"><Content /></article></section>
 <section class="container index-section"><div class="section-top"><span class="section-kicker">01 / RESEARCH DOMAINS</span><a href={localUrl('/research/')}>ALL AREAS ↗</a></div><h2>Research</h2><div class="entry-grid">{research.map((entry,i)=><EntryCard entry={entry} index={i} kind="RESEARCH" />)}</div></section>
 <section class="container index-section"><div class="section-top"><span class="section-kicker">02 / SELECTED WORK</span><a href={localUrl('/projects/')}>ALL PROJECTS ↗</a></div><h2>Projects</h2><div class="entry-grid">{projects.map((entry,i)=><EntryCard entry={entry} index={i} kind="PROJECT" />)}</div></section>
 <section class="container quick-links"><span class="section-kicker">03 / INDEX</span><div class="quick-grid"><a href={localUrl('/publications/')}>Publications <span>↗</span></a><a href={localUrl('/software/')}>Software & Demos <span>↗</span></a><a href={localUrl('/people/')}>People <span>↗</span></a><a href={localUrl('/contact/')}>Contact <span>↗</span></a></div></section>
</BaseLayout>
